{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-utils/schema.json",
  "productName": "Lab Data System",
  "version": "0.5.4",
  "identifier": "com.liuyedao.biolab",
  "build": {
    "beforeBuildCommand": "pnpm build",
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Lab Data System",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640,
        "acceptFirstMouse": true
      }
    ],
    "security": {
      "assetProtocol": {
        "scope": [
          "**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEU0RjEzMDVEMjg2NDEzNzAKUldSd0UyUW9YVER4NUMxOFFFbFFESGxHemdSNWVNbE9YOHovZVdrSVcvNkdMMU5Lck5XZU82czEK",
      "endpoints": [
        "https://github.com/FingertipsLDS/lab-data-system/releases/latest/download/latest.json"
      ]
    }
  }
}
